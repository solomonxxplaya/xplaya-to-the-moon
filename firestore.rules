rules_version = '2';

// XPLAYA — Cloud Firestore security rules (corrected).
//
// Fixes vs. previous version:
//  1. Missing fields no longer deny access. `data.suspended` / `data.role` are
//     read with .get(<key>, <default>) so a profile without those fields
//     (every profile the app creates) evaluates normally instead of erroring.
//  2. `live_streams` used `allow read: true;` (missing `if`) — a syntax error
//     that prevents the whole ruleset from publishing.
//  3. Role/suspension lookups are centralised in one helper to keep the number
//     of document get() calls within the per-request limit.
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleOf() {
      return hasUserProfile() ? profile().get('role', 'user') : 'user';
    }

    function isAdmin() {
      return signedIn() && (roleOf() == 'admin' || roleOf() == 'owner');
    }

    function isStaff() {
      return signedIn() &&
        (roleOf() == 'admin' || roleOf() == 'owner' || roleOf() == 'staff');
    }

    // A user is only blocked when the profile explicitly says suspended == true.
    function notSuspended() {
      return signedIn() &&
        (!hasUserProfile() || profile().get('suspended', false) != true);
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      allow read: if true;

      // A user may create only their own profile, never as admin/staff/owner.
      allow create: if isSelf(uid)
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('suspended', false) == false;

      // Owner may change normal profile information only.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'username',
          'usernameLower',
          'bio',
          'photoURL',
          'avatar',
          'coverPhoto',
          'updatedAt'
        ]);

      // Staff/admin may moderate accounts (suspend, verify, set roles).
      allow update: if isStaff();

      allow delete: if false;

      // Private progression (exact XP) — owner only.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ============================================================
    // FOLLOWS — id: {followerId}_{followingId}
    // ============================================================

    match /follows/{followDocId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followDocId == request.auth.uid + '_' + request.resource.data.followingId;

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    // ============================================================
    // LIKES — id: {userId}_{videoId}
    // ============================================================

    match /likes/{likeDocId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && likeDocId == request.auth.uid + '_' + request.resource.data.videoId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ============================================================
    // COMMENTS
    // ============================================================

    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.text is string;

      allow update: if isStaff()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId);

      allow delete: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ============================================================
    // SHARES / VIEW EVENTS (append-only)
    // ============================================================

    match /shares/{shareId} {
      allow read: if true;

      allow create: if request.resource.data.videoId is string
        && request.resource.data.channel is string
        && (!signedIn() || notSuspended());

      allow update, delete: if false;
    }

    // ============================================================
    // VIDEOS / CLIPS
    // ============================================================

    match /videos/{videoId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isStaff()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId);

      allow delete: if isStaff()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{reportId} {
      allow create: if signedIn() && notSuspended();
      allow read, update, delete: if isStaff();
    }

    // ============================================================
    // APP SETTINGS / ADMIN / TOURNAMENTS / SHOP / LIVE
    // ============================================================

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /live_streams/{streamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
