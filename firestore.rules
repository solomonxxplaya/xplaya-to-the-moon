rules_version = '2';

// XPLAYA — Cloud Firestore security rules (corrected).
//
// Fixes vs. previous version:
//  1. Missing fields no longer deny access. `data.suspended` / `data.role` are
//     read with .get(<key>, <default>) so a profile without those fields
//     (every profile the app creates) evaluates normally instead of erroring.
//  2. `live_streams` used `allow read: true;` (missing `if`) — a syntax error
//     that prevents the whole ruleset from publishing.
//  3. Role/suspension lookups are centralised in one helper to keep the number
//     of document get() calls within the per-request limit.
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleOf() {
      return hasUserProfile() ? profile().get('role', 'user') : 'user';
    }

    function isAdmin() {
      return signedIn() && (roleOf() == 'admin' || roleOf() == 'owner');
    }

    // The founding XPLAYA account, identified by its verified sign-in email.
    function isPlatformOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'solomonxxplaya@gmail.com';
    }

    function isStaff() {
      return signedIn() &&
        (roleOf() == 'admin' || roleOf() == 'owner' || roleOf() == 'staff');
    }

    // A user is only blocked when the profile explicitly says suspended == true.
    function notSuspended() {
      return signedIn() &&
        (!hasUserProfile() || profile().get('suspended', false) != true);
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      allow read: if true;

      // A user may create only their own profile, never as admin/staff/owner.
      allow create: if isSelf(uid)
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('suspended', false) == false;

      // Owner may change normal profile information only.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'username',
          'usernameLower',
          'bio',
          'photoURL',
          'avatar',
          'coverPhoto',
          'updatedAt'
        ]);

      // Staff/admin may moderate accounts (suspend, verify, set roles).
      allow update: if isStaff();

      // Platform owner bootstrap. Roles live in the database, but a database
      // with no admin yet can never gain one. The verified Google/Firebase
      // account below may set ITS OWN role to 'owner' (and nothing else), so
      // the real role system stays the single source of truth from then on.
      allow update: if isSelf(uid)
        && isPlatformOwnerEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role == 'owner';

      allow delete: if false;

      // Private progression (exact XP) — owner only.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ============================================================
    // FOLLOWS — id: {followerId}_{followingId}
    // ============================================================

    match /follows/{followDocId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followDocId == request.auth.uid + '_' + request.resource.data.followingId;

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    // ============================================================
    // LIKES — id: {userId}_{videoId}
    // ============================================================

    match /likes/{likeDocId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && likeDocId == request.auth.uid + '_' + request.resource.data.videoId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ============================================================
    // COMMENTS
    // ============================================================

    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.text is string;

      allow update: if isStaff()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId);

      allow delete: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ============================================================
    // SHARES / VIEW EVENTS (append-only)
    // ============================================================

    match /shares/{shareId} {
      allow read: if true;

      allow create: if request.resource.data.videoId is string
        && request.resource.data.channel is string
        && (!signedIn() || notSuspended());

      allow update, delete: if false;
    }

    // ============================================================
    // VIDEOS / CLIPS
    // ============================================================

    match /videos/{videoId} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isStaff()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId);

      allow delete: if isStaff()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{reportId} {
      allow create: if signedIn() && notSuspended();
      allow read, update, delete: if isStaff();
    }

    // ============================================================
    // APP SETTINGS / ADMIN / TOURNAMENTS / SHOP / LIVE
    // ============================================================

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /live_streams/{streamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // MESSAGING — private chats and groups
    // ============================================================

    match /conversations/{conversationId} {

      // Friendship = a two-way follow. Messaging is friends-only, enforced here
      // on the server and not only hidden in the app screens.
      function followsEachOther(a, b) {
        return exists(/databases/$(database)/documents/follows/$(a + '_' + b))
          && exists(/databases/$(database)/documents/follows/$(b + '_' + a));
      }

      function otherPrivateMember() {
        return request.resource.data.memberIds[0] == request.auth.uid
          ? request.resource.data.memberIds[1]
          : request.resource.data.memberIds[0];
      }

      // Members joining in this update (empty for every non-membership change).
      function addedMembers() {
        return request.resource.data.memberIds.removeAll(resource.data.memberIds);
      }

      // Members may only be added one at a time, and only if they are a friend
      // of the member performing the update.
      function addedMembersAreFriends() {
        return addedMembers().size() == 0
          || (addedMembers().size() == 1
              && followsEachOther(request.auth.uid, addedMembers()[0]));
      }

      function convo() {
        return resource.data;
      }

      function isConvoMember() {
        return signedIn() && request.auth.uid in convo().memberIds;
      }

      function convoRole() {
        return convo().get('roles', {}).get(request.auth.uid, '');
      }

      function isConvoAdmin() {
        return isConvoMember() && (convoRole() == 'owner' || convoRole() == 'admin');
      }

      function isConvoOwner() {
        return signedIn() && convo().get('ownerId', '') == request.auth.uid;
      }

      // Only members (and XPLAYA staff for moderation) may read a conversation.
      allow read: if isConvoMember() || isStaff();

      // A private chat must contain exactly the creator and one other player.
      // A group is always created by its own owner.
      allow create: if signedIn()
        && notSuspended()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.type == 'private'
            && request.resource.data.memberIds.size() == 2)
          || (request.resource.data.type == 'group'
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.roles[request.auth.uid] == 'owner')
        );

      // Members may update conversation state (send summary, unread, mute,
      // hide). Group info, permissions, roles, ownership and membership are
      // restricted to the group's own admins / owner.
      allow update: if isStaff()
        || (
          isConvoMember()
          && notSuspended()
          && (
            request.resource.data.diff(convo()).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageSenderId', 'lastMessageAt',
              'unread', 'readAt', 'mutedBy', 'hiddenFor', 'updatedAt'
            ])
            || (isConvoAdmin() && convo().type == 'group')
            || (isConvoOwner())
            // Any member may leave the group on their own.
            || request.resource.data.memberIds.hasOnly(convo().memberIds)
          )
        );

      allow delete: if isStaff() || isConvoOwner();

      match /messages/{messageId} {

        function parent() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function memberOfParent() {
          return signedIn() && request.auth.uid in parent().memberIds;
        }

        function parentRole() {
          return parent().get('roles', {}).get(request.auth.uid, '');
        }

        function sendAllowed() {
          return parent().get('permissions', {}).get('sendMessages', 'members') == 'members'
            || parentRole() == 'owner'
            || parentRole() == 'admin';
        }

        allow read: if memberOfParent() || isStaff();

        allow create: if memberOfParent()
          && notSuspended()
          && sendAllowed()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;

        // Senders may delete their own message; group admins and XPLAYA staff
        // may moderate any message.
        allow update, delete: if isStaff()
          || (memberOfParent()
              && (resource.data.senderId == request.auth.uid
                  || parentRole() == 'owner'
                  || parentRole() == 'admin'));
      }
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
